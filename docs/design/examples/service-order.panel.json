{
  "schemaVersion": "1.0.0",
  "code": "SERVICE_ORDER",
  "version": "1.0.0",
  "title": "服务工单",
  "description": "跨行业通用的服务受理、分派、审批和项目明细面板示例",
  "kind": "document",
  "identity": {
    "recordKey": "id",
    "displayKey": "orderNo",
    "versionKey": "version"
  },
  "state": {
    "field": "status",
    "initial": "draft",
    "options": [
      { "value": "draft", "label": "草稿", "tone": "neutral" },
      { "value": "submitted", "label": "已提交", "tone": "info" },
      { "value": "approved", "label": "已批准", "tone": "success" },
      { "value": "rejected", "label": "已驳回", "tone": "danger" },
      { "value": "cancelled", "label": "已取消", "tone": "warning" }
    ],
    "transitions": [
      { "action": "submit", "from": ["draft", "rejected"], "to": "submitted" },
      { "action": "approve", "from": ["submitted"], "to": "approved" },
      { "action": "reject", "from": ["submitted"], "to": "rejected" },
      { "action": "cancel", "from": ["draft", "rejected"], "to": "cancelled" }
    ]
  },
  "fields": [
    {
      "key": "id",
      "label": "记录ID",
      "type": "text",
      "readonly": true,
      "hidden": true
    },
    {
      "key": "version",
      "label": "数据版本",
      "type": "integer",
      "readonly": true,
      "hidden": true
    },
    {
      "key": "orderNo",
      "label": "工单编号",
      "type": "text",
      "readonly": true,
      "ui": { "span": 1, "width": 180 }
    },
    {
      "key": "status",
      "label": "状态",
      "type": "enum",
      "readonly": true,
      "options": [
        { "value": "draft", "label": "草稿" },
        { "value": "submitted", "label": "已提交" },
        { "value": "approved", "label": "已批准" },
        { "value": "rejected", "label": "已驳回" },
        { "value": "cancelled", "label": "已取消" }
      ],
      "ui": { "span": 1, "width": 100, "align": "center" }
    },
    {
      "key": "createdDate",
      "label": "受理日期",
      "type": "date",
      "required": true,
      "ui": { "span": 1, "format": "YYYY-MM-DD" }
    },
    {
      "key": "customerId",
      "label": "客户",
      "type": "reference",
      "required": true,
      "reference": {
        "panel": "CUSTOMER",
        "valueField": "id",
        "labelField": "name",
        "filter": { "active": true },
        "map": [
          { "from": "name", "to": "customerName" },
          { "from": "contact", "to": "contact" },
          { "from": "phone", "to": "contactPhone" }
        ]
      },
      "ui": { "span": 1, "placeholder": "选择客户" }
    },
    {
      "key": "customerName",
      "label": "客户名称",
      "type": "text",
      "readonly": true,
      "ui": { "span": 1 }
    },
    {
      "key": "contact",
      "label": "联系人",
      "type": "text",
      "ui": { "span": 1 }
    },
    {
      "key": "contactPhone",
      "label": "联系电话",
      "type": "text",
      "validation": {
        "maxLength": 30,
        "pattern": "^[0-9+() -]*$",
        "message": "联系电话格式不正确"
      },
      "ui": { "span": 1 }
    },
    {
      "key": "ownerId",
      "label": "负责人",
      "type": "reference",
      "required": true,
      "reference": {
        "panel": "EMPLOYEE",
        "valueField": "id",
        "labelField": "name",
        "filter": { "active": true },
        "map": [
          { "from": "name", "to": "ownerName" }
        ]
      },
      "ui": { "span": 1, "placeholder": "选择负责人" }
    },
    {
      "key": "ownerName",
      "label": "负责人名称",
      "type": "text",
      "readonly": true,
      "ui": { "span": 1 }
    },
    {
      "key": "priority",
      "label": "优先级",
      "type": "enum",
      "required": true,
      "defaultValue": "normal",
      "options": [
        { "value": "low", "label": "低" },
        { "value": "normal", "label": "普通" },
        { "value": "high", "label": "高" },
        { "value": "urgent", "label": "紧急" }
      ],
      "ui": { "span": 1 }
    },
    {
      "key": "dueDate",
      "label": "要求完成日期",
      "type": "date",
      "ui": { "span": 1, "format": "YYYY-MM-DD" }
    },
    {
      "key": "description",
      "label": "问题描述",
      "type": "textarea",
      "required": true,
      "validation": {
        "minLength": 5,
        "maxLength": 1000,
        "message": "问题描述需为 5 至 1000 个字符"
      },
      "ui": { "span": 3, "placeholder": "填写客户诉求、现场情况或服务目标" }
    },
    {
      "key": "totalAmount",
      "label": "合计金额",
      "type": "decimal",
      "readonly": true,
      "precision": 18,
      "scale": 2,
      "ui": { "span": 1, "align": "right" }
    }
  ],
  "detailSections": [
    {
      "key": "items",
      "label": "服务项目",
      "required": true,
      "minRows": 1,
      "fields": [
        {
          "key": "lineId",
          "label": "行ID",
          "type": "text",
          "readonly": true,
          "hidden": true
        },
        {
          "key": "itemId",
          "label": "项目",
          "type": "reference",
          "required": true,
          "reference": {
            "panel": "SERVICE_ITEM",
            "valueField": "id",
            "labelField": "name",
            "filter": { "active": true },
            "map": [
              { "from": "name", "to": "itemName" },
              { "from": "unit", "to": "unit" },
              { "from": "standardPrice", "to": "unitPrice" }
            ]
          },
          "ui": { "width": 160 }
        },
        {
          "key": "itemName",
          "label": "项目名称",
          "type": "text",
          "readonly": true,
          "ui": { "width": 180 }
        },
        {
          "key": "unit",
          "label": "单位",
          "type": "text",
          "readonly": true,
          "ui": { "width": 90, "align": "center" }
        },
        {
          "key": "quantity",
          "label": "数量",
          "type": "decimal",
          "required": true,
          "defaultValue": 1,
          "precision": 18,
          "scale": 2,
          "validation": { "min": 0.01, "message": "数量必须大于 0" },
          "ui": { "width": 110, "align": "right" }
        },
        {
          "key": "unitPrice",
          "label": "单价",
          "type": "decimal",
          "required": true,
          "defaultValue": 0,
          "precision": 18,
          "scale": 2,
          "validation": { "min": 0, "message": "单价不能小于 0" },
          "ui": { "width": 120, "align": "right" }
        },
        {
          "key": "amount",
          "label": "金额",
          "type": "decimal",
          "readonly": true,
          "precision": 18,
          "scale": 2,
          "ui": { "width": 130, "align": "right" }
        },
        {
          "key": "remark",
          "label": "行备注",
          "type": "text",
          "validation": { "maxLength": 200 },
          "ui": { "width": 220 }
        }
      ],
      "calculations": [
        {
          "target": "amount",
          "expression": {
            "op": "multiply",
            "args": [
              { "field": "quantity" },
              { "field": "unitPrice" }
            ]
          },
          "scale": 2
        }
      ],
      "summary": ["quantity", "amount"]
    }
  ],
  "views": {
    "list": {
      "pageSize": 20,
      "keywordFields": ["orderNo", "customerName", "description"],
      "filters": ["status", "customerId", "ownerId", "priority", "createdDate"],
      "columns": [
        { "field": "orderNo", "width": 180, "fixed": "left", "sortable": true },
        { "field": "status", "width": 100, "align": "center" },
        { "field": "createdDate", "width": 130, "sortable": true },
        { "field": "customerName", "minWidth": 180 },
        { "field": "ownerName", "width": 120 },
        { "field": "priority", "width": 100, "align": "center" },
        { "field": "dueDate", "width": 130 },
        { "field": "totalAmount", "width": 130, "align": "right" }
      ],
      "detailPreview": ["items"]
    },
    "form": {
      "columns": 3,
      "sections": [
        {
          "key": "basic",
          "title": "基本信息",
          "fields": [
            "orderNo",
            "status",
            "createdDate",
            "customerId",
            "customerName",
            "priority",
            "contact",
            "contactPhone",
            "dueDate",
            "ownerId",
            "ownerName",
            "totalAmount"
          ]
        },
        {
          "key": "description",
          "title": "问题描述",
          "fields": ["description"],
          "collapsible": false
        }
      ],
      "details": ["items"]
    }
  },
  "actions": [
    {
      "id": "create",
      "label": "新增",
      "scope": "list",
      "intent": "primary",
      "placement": { "group": "edit", "order": 10 },
      "executor": { "type": "builtin", "operation": "create" },
      "permission": "serviceOrder:create"
    },
    {
      "id": "save",
      "label": "保存",
      "scope": "form",
      "intent": "primary",
      "placement": { "group": "edit", "order": 20 },
      "executor": { "type": "builtin", "operation": "save" },
      "permission": "serviceOrder:write",
      "enabledWhen": {
        "field": "$state",
        "operator": "in",
        "value": ["draft", "rejected"]
      }
    },
    {
      "id": "submit",
      "label": "提交",
      "scope": "form",
      "intent": "primary",
      "placement": { "group": "workflow", "order": 10 },
      "executor": { "type": "dataSource", "operation": "submit" },
      "permission": "serviceOrder:submit",
      "enabledWhen": {
        "field": "$state",
        "operator": "in",
        "value": ["draft", "rejected"]
      },
      "confirmation": {
        "title": "提交工单",
        "message": "确认提交当前工单？"
      }
    },
    {
      "id": "approve",
      "label": "批准",
      "scope": "form",
      "intent": "success",
      "placement": { "group": "workflow", "order": 20 },
      "executor": { "type": "dataSource", "operation": "approve" },
      "permission": "serviceOrder:approve",
      "enabledWhen": {
        "field": "$state",
        "operator": "eq",
        "value": "submitted"
      },
      "confirmation": {
        "title": "批准工单",
        "message": "确认批准当前工单？"
      }
    },
    {
      "id": "reject",
      "label": "驳回",
      "scope": "form",
      "intent": "danger",
      "placement": { "group": "workflow", "order": 30 },
      "executor": { "type": "dataSource", "operation": "reject" },
      "permission": "serviceOrder:approve",
      "enabledWhen": {
        "field": "$state",
        "operator": "eq",
        "value": "submitted"
      },
      "confirmation": {
        "title": "驳回工单",
        "message": "填写原因后驳回当前工单。",
        "requireReason": true
      }
    },
    {
      "id": "cancel",
      "label": "取消工单",
      "scope": "form",
      "intent": "warning",
      "placement": { "group": "more", "order": 10 },
      "executor": { "type": "dataSource", "operation": "cancel" },
      "permission": "serviceOrder:cancel",
      "enabledWhen": {
        "field": "$state",
        "operator": "in",
        "value": ["draft", "rejected"]
      },
      "confirmation": {
        "title": "取消工单",
        "message": "取消后不可继续编辑，确认取消？",
        "requireReason": true
      }
    },
    {
      "id": "remove",
      "label": "删除",
      "scope": "selection",
      "intent": "danger",
      "placement": { "group": "more", "order": 20 },
      "executor": { "type": "builtin", "operation": "remove" },
      "permission": "serviceOrder:delete",
      "requiresSelection": true,
      "enabledWhen": {
        "field": "$state",
        "operator": "eq",
        "value": "draft"
      },
      "confirmation": {
        "title": "删除工单",
        "message": "删除后无法恢复，确认删除所选工单？"
      }
    },
    {
      "id": "export",
      "label": "导出",
      "scope": "list",
      "intent": "default",
      "placement": { "group": "more", "order": 30 },
      "executor": { "type": "builtin", "operation": "export" },
      "permission": "serviceOrder:read"
    }
  ],
  "extensions": {
    "panel-sdk.audit": {
      "enabled": true,
      "showTimeline": true
    },
    "panel-sdk.import": {
      "enabled": true,
      "target": "items"
    }
  }
}