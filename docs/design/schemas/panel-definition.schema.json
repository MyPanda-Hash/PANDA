{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://panel-sdk.local/schemas/panel-definition-v1.json",
  "title": "Panel Definition V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "code",
    "version",
    "title",
    "kind",
    "identity",
    "fields",
    "detailSections",
    "views",
    "actions"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "kind": {
      "enum": ["document", "master", "report", "settings"]
    },
    "identity": {
      "$ref": "#/$defs/identity"
    },
    "state": {
      "$ref": "#/$defs/stateMachine"
    },
    "fields": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/field"
      }
    },
    "detailSections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/detailSection"
      }
    },
    "views": {
      "$ref": "#/$defs/views"
    },
    "actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/action"
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9.-]+$"
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recordKey", "displayKey"],
      "properties": {
        "recordKey": {
          "$ref": "#/$defs/key"
        },
        "displayKey": {
          "$ref": "#/$defs/key"
        },
        "versionKey": {
          "$ref": "#/$defs/key"
        }
      }
    },
    "key": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
    },
    "stateMachine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "initial", "options", "transitions"],
      "properties": {
        "field": {
          "$ref": "#/$defs/key"
        },
        "initial": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["value", "label"],
            "properties": {
              "value": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "tone": {
                "enum": ["neutral", "info", "primary", "success", "warning", "danger"]
              }
            }
          }
        },
        "transitions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["action", "from", "to"],
            "properties": {
              "action": {
                "$ref": "#/$defs/key"
              },
              "from": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "to": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label", "type"],
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "type": {
          "enum": [
            "text",
            "textarea",
            "integer",
            "decimal",
            "boolean",
            "date",
            "datetime",
            "enum",
            "reference",
            "image",
            "file"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "readonly": {
          "type": "boolean"
        },
        "hidden": {
          "type": "boolean"
        },
        "defaultValue": {},
        "precision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 38
        },
        "scale": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/option"
          }
        },
        "reference": {
          "$ref": "#/$defs/reference"
        },
        "validation": {
          "$ref": "#/$defs/validation"
        },
        "ui": {
          "$ref": "#/$defs/fieldUi"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "enum"
              }
            },
            "required": ["type"]
          },
          "then": {
            "required": ["options"]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "reference"
              }
            },
            "required": ["type"]
          },
          "then": {
            "required": ["reference"]
          }
        }
      ]
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "label"],
      "properties": {
        "value": {
          "oneOf": [
            { "type": "string" },
            { "type": "number" },
            { "type": "boolean" }
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "disabled": {
          "type": "boolean"
        }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["panel", "valueField", "labelField"],
      "properties": {
        "panel": {
          "$ref": "#/$defs/key"
        },
        "valueField": {
          "$ref": "#/$defs/key"
        },
        "labelField": {
          "$ref": "#/$defs/key"
        },
        "multiple": {
          "type": "boolean"
        },
        "filter": {
          "type": "object",
          "additionalProperties": true
        },
        "map": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to"],
            "properties": {
              "from": {
                "$ref": "#/$defs/key"
              },
              "to": {
                "$ref": "#/$defs/key"
              }
            }
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "minLength": {
          "type": "integer",
          "minimum": 0
        },
        "maxLength": {
          "type": "integer",
          "minimum": 0
        },
        "pattern": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "fieldUi": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "span": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "width": {
          "type": "integer",
          "minimum": 40
        },
        "placeholder": {
          "type": "string"
        },
        "align": {
          "enum": ["left", "center", "right"]
        },
        "format": {
          "type": "string"
        }
      }
    },
    "detailSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label", "fields"],
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "minRows": {
          "type": "integer",
          "minimum": 0
        },
        "maxRows": {
          "type": "integer",
          "minimum": 1
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/field"
          }
        },
        "calculations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/calculation"
          }
        },
        "summary": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/key"
          }
        }
      }
    },
    "calculation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "expression"],
      "properties": {
        "target": {
          "$ref": "#/$defs/key"
        },
        "expression": {
          "$ref": "#/$defs/expression"
        },
        "scale": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18
        }
      }
    },
    "expression": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["field"],
          "properties": {
            "field": {
              "$ref": "#/$defs/key"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["value"],
          "properties": {
            "value": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "args"],
          "properties": {
            "op": {
              "enum": ["add", "subtract", "multiply", "divide", "min", "max", "round"]
            },
            "args": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/expression"
              }
            }
          }
        }
      ]
    },
    "views": {
      "type": "object",
      "additionalProperties": false,
      "required": ["list", "form"],
      "properties": {
        "list": {
          "$ref": "#/$defs/listView"
        },
        "form": {
          "$ref": "#/$defs/formView"
        }
      }
    },
    "listView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["columns"],
      "properties": {
        "pageSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "keywordFields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/key"
          }
        },
        "filters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/key"
          }
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/column"
          }
        },
        "detailPreview": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/key"
          }
        }
      }
    },
    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field"],
      "properties": {
        "field": {
          "$ref": "#/$defs/key"
        },
        "label": {
          "type": "string"
        },
        "width": {
          "type": "integer",
          "minimum": 40
        },
        "minWidth": {
          "type": "integer",
          "minimum": 40
        },
        "fixed": {
          "enum": ["left", "right"]
        },
        "sortable": {
          "type": "boolean"
        },
        "align": {
          "enum": ["left", "center", "right"]
        }
      }
    },
    "formView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["columns", "sections", "details"],
      "properties": {
        "columns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "sections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/formSection"
          }
        },
        "details": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/key"
          }
        }
      }
    },
    "formSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "title", "fields"],
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/key"
          }
        },
        "collapsible": {
          "type": "boolean"
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "scope", "executor"],
      "properties": {
        "id": {
          "$ref": "#/$defs/key"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "enum": ["list", "form", "row", "selection", "global"]
        },
        "intent": {
          "enum": ["default", "primary", "success", "warning", "danger"]
        },
        "placement": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "group": {
              "$ref": "#/$defs/key"
            },
            "order": {
              "type": "integer"
            }
          }
        },
        "executor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "operation"],
          "properties": {
            "type": {
              "enum": ["builtin", "dataSource"]
            },
            "operation": {
              "$ref": "#/$defs/key"
            }
          }
        },
        "permission": {
          "type": "string",
          "minLength": 1
        },
        "requiresSelection": {
          "type": "boolean"
        },
        "visibleWhen": {
          "$ref": "#/$defs/condition"
        },
        "enabledWhen": {
          "$ref": "#/$defs/condition"
        },
        "confirmation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "message"],
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string",
              "minLength": 1
            },
            "requireReason": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "condition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["all"],
          "properties": {
            "all": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/condition"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["any"],
          "properties": {
            "any": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/condition"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["not"],
          "properties": {
            "not": {
              "$ref": "#/$defs/condition"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["field", "operator"],
          "properties": {
            "field": {
              "type": "string",
              "pattern": "^\\$?[A-Za-z][A-Za-z0-9_.-]{0,63}$"
            },
            "operator": {
              "enum": ["eq", "ne", "in", "notIn", "exists", "gt", "gte", "lt", "lte"]
            },
            "value": {}
          }
        }
      ]
    }
  }
}