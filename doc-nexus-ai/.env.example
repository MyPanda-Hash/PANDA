# doc-nexus-ai 环境变量模板
#
# 复制为 .env 后填入真实值。.env 已被 .gitignore 排除，**不要提交**。
# 所有键都是可选的：缺省时后端按本地开发默认值运行。

# ---------- 基础 ----------
DOC_NEXUS_ENVIRONMENT=local
TZ=Asia/Shanghai
# JWT 签名密钥：至少 32 位随机字符串
DOC_NEXUS_JWT_SECRET=
# 首次启动初始化管理员
DOC_NEXUS_BOOTSTRAP_USERNAME=admin
DOC_NEXUS_BOOTSTRAP_PASSWORD=
DOC_NEXUS_FRONTEND_ORIGIN=http://localhost:18091

# ---------- 模型（阿里云百炼/DashScope 兼容接口）----------
ALIYUN_DEEP_API_KEY=
DOC_NEXUS_PI_CHAT_MODEL=
DOC_NEXUS_PI_WRITING_MODEL=

# ---------- Harness 网关 ----------
DOC_NEXUS_PI_HARNESS_GATEWAY_URL=
DOC_NEXUS_PI_HARNESS_GATEWAY_TOKEN=
DOC_NEXUS_PI_EXECUTION_MODE=
DOC_NEXUS_PI_BUILTIN_SKILL_ALLOWLIST=
DOC_NEXUS_PI_MAX_CONCURRENCY=4
DOC_NEXUS_PI_MAX_CONCURRENCY_PER_USER=2

# ---------- 对象存储（MinIO，可选）----------
DOC_NEXUS_MINIO_ENABLED=false
DOC_NEXUS_MINIO_URL=
DOC_NEXUS_MINIO_SHOW_URL=
DOC_NEXUS_MINIO_CORS_ALLOW_ALL=false
DOC_NEXUS_MINIO_ACCESS_KEY=
DOC_NEXUS_MINIO_SECRET_KEY=
DOC_NEXUS_MINIO_BUCKET=
DOC_NEXUS_MINIO_TEMP_BUCKET=
DOC_NEXUS_DOCUMENT_UPLOAD_PUBLIC_URL=

# ---------- 文档与知识检索 ----------
DOC_NEXUS_DOCUMENT_UPLOADS_ENABLED=true
DOC_NEXUS_LINKMIND_ENABLED=false
DOC_NEXUS_EMBEDDING_API_URL=
DOC_NEXUS_EMBEDDING_API_KEY=
DOC_NEXUS_EMBEDDING_API_MODEL=
DOC_NEXUS_EMBEDDING_DIMENSIONS=

# ---------- 与 light-mes 集成（单点登录 / 数据回写）----------
MES_BASE_URL=http://localhost:8080
MES_USERNAME=
MES_PASSWORD=
MES_MODE=
DOC_NEXUS_MES_AUTH_ENABLED=true
DOC_NEXUS_MES_AUTH_BASE_URL=http://localhost:8080
# 必须与 light-mes 侧 MES_AI_SSO_SECRET 完全一致
DOC_NEXUS_MES_SSO_SECRET=

# ---------------- 数据脱敏（上云前）----------------
# 云端模型出口的脱敏策略：mask=脱敏后上云（默认）/ block=检测到敏感数据即拒绝 / off=关闭
DOC_NEXUS_DATA_MASK_MODE=mask
# 额外业务词表（逗号分隔），命中即整体替换；建议填客户/供应商简称
DOC_NEXUS_DATA_MASK_TERMS=
# 内网域名白名单（公网域名托管的内网网关），命中则视为可信、不脱敏
DOC_NEXUS_DATA_MASK_TRUSTED_HOSTS=
# 图片/音频无法脱敏：block=云端默认拦截（默认）/ allow=放行
DOC_NEXUS_DATA_MASK_MEDIA_POLICY=block
